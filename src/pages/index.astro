---
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar-profile.png';
import logo from '@/assets/logo.svg';
import Icon from '@/components/Icon.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { links, profile } from '@/data/links';
---

<BaseLayout>
  <main
    id="main"
    class="relative mx-auto flex min-h-dvh w-full max-w-2xl flex-col px-5 py-6 sm:px-8 sm:py-10"
  >
    <section
      class="relative overflow-hidden rounded-3xl border border-steel bg-graphite px-5 py-6 shadow-xl shadow-black/30 sm:px-8 sm:py-8"
      aria-labelledby="profile-name"
    >
      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-acid/60 to-transparent"
      >
      </div>

      <header class="flex flex-col items-center text-center">
        <div class="mb-4 flex w-full items-center justify-between">
          <span class="font-sans text-[10px] tracking-[0.24em] text-smoke uppercase">
            Perfil digital
          </span>
          <Image
            src={logo}
            alt="Logotipo JM"
            width={50}
            loading="eager"
            class="h-auto w-11 sm:w-12"
          />
        </div>

        <div class="group relative">
          <div
            aria-hidden="true"
            class="absolute -inset-1.5 rounded-full border border-acid/20"
          >
          </div>
          <Image
            src={avatar}
            alt="Retrato de Juan Maldonado"
            width={192}
            height={192}
            format="webp"
            quality={90}
            class="relative h-24 w-24 rounded-full border-2 border-steel object-cover shadow-lg shadow-black/40 sm:h-28 sm:w-28"
            loading="eager"
            fetchpriority="high"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -inset-1.5 animate-[spin_900ms_cubic-bezier(0.22,1,0.36,1)_1] rounded-full motion-reduce:animate-none"
          >
            <div
              class="absolute inset-0 rounded-full group-hover:animate-[spin_700ms_cubic-bezier(0.22,1,0.36,1)_1] motion-reduce:animate-none"
            >
              <span class="absolute right-0 bottom-3 h-4 w-4 rounded-full border-4 border-graphite bg-acid"></span>
            </div>
          </div>
        </div>

        <p class="mt-6 font-sans text-[10px] font-semibold tracking-[0.2em] text-acid uppercase">
          Tecnología · Negocio digital · Sistemas
        </p>
        <h1
          id="profile-name"
          class="mt-2 font-sans text-3xl font-bold tracking-[-0.035em] text-bone sm:text-4xl"
        >
          {profile.name}
        </h1>
        <p class="mt-2 font-sans text-sm text-smoke">{profile.handle}</p>
        <p class="mt-4 max-w-lg text-sm font-light leading-6 text-bone sm:text-[15px]">
          {profile.description}
        </p>
      </header>

      <nav class="mt-8" aria-label="Enlaces principales">
        <h2 class="sr-only">Consultoría, LinkedIn, sobre mí y blog</h2>
        <ul class="flex flex-col gap-2.5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-astro-prefetch={link.href === '/blog' || link.href === '/sobre-mi/' ? 'hover' : undefined}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'group flex min-h-16 items-center gap-3 rounded-xl border px-3 py-3 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-acid motion-reduce:transition-none sm:px-4',
                    link.primary
                      ? 'border-acid/35 bg-void hover:border-acid/65 hover:bg-acid/5'
                      : 'border-steel bg-void hover:border-acid/50 hover:bg-steel/50',
                  ]}
                >
                  <span
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-steel bg-graphite/70 transition-colors group-hover:border-acid/45 group-hover:text-acid motion-reduce:transition-none"
                  >
                    <Icon name={link.icon} size={19} class="h-[18px] w-[18px]" />
                  </span>

                  <span class="min-w-0 flex-1">
                    <span class="block font-sans text-sm font-semibold text-bone sm:text-[15px]">
                      {link.title}
                    </span>
                    <span class="mt-0.5 block text-[11px] font-light leading-4 text-smoke sm:text-xs">
                      {link.description}
                    </span>
                  </span>

                  <span
                    class="hidden shrink-0 items-center gap-1.5 font-sans text-[10px] tracking-wider text-smoke uppercase transition-colors group-hover:text-acid sm:flex"
                  >
                    {link.action}
                    <Icon name="lucide:arrow-up-right" size={14} class="h-3.5 w-3.5" />
                  </span>
                  {(link.newTab || link.href.startsWith('http')) && (
                    <span class="sr-only"> (se abre en una pestaña nueva)</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <SocialLinks />
    </section>

    <footer
      class="mt-6 flex flex-col items-center justify-center gap-3 font-sans text-[11px] tracking-[0.14em] text-smoke uppercase"
    >
      <button
        type="button"
        data-newsletter-open
        class="group inline-flex min-h-10 items-center gap-2 rounded-full border border-steel bg-graphite px-4 text-[10px] font-semibold tracking-[0.12em] text-bone transition-colors hover:border-acid/50 hover:bg-acid/10 hover:text-acid focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-acid motion-reduce:transition-none"
      >
        <Icon name="lucide:mail" size={14} class="h-3.5 w-3.5" />
        Newsletter
      </button>
      <span class="h-1.5 w-1.5 rounded-full bg-acid/70"></span>
      <span>juanmaldonado.digital · {new Date().getFullYear()}</span>
    </footer>
  </main>
</BaseLayout>
