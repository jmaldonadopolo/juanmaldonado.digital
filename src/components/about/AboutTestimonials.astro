---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import alfieriPhoto from '@/assets/testimonials/alfieri-sala.jpg';
import paoloPhoto from '@/assets/testimonials/paolo-sala.jpg';

const testimonials = [
  {
    name: 'Alfieri Sala del Carpio',
    role: 'Gerente General',
    company: 'Sourcing Brothers',
    href: 'https://www.linkedin.com/in/alfieri-sala-del-carpio-/',
    image: alfieriPhoto,
    initials: 'AS',
    quote:
      'Con Juan encuentro una conversación franca y enfocada en entender el reto antes de discutir alternativas. Eso ayuda a ordenar prioridades y elegir un camino que tenga sentido para el negocio.',
  },
  {
    name: 'Paolo Sala del Carpio',
    role: 'Comercial',
    company: 'Sourcing Brothers',
    href: 'https://www.linkedin.com/in/paolo-sala-del-carpio/',
    image: paoloPhoto,
    initials: 'PS',
    quote:
      'Destaco que Juan conecta las necesidades comerciales con la realidad tecnológica. Sus preguntas ayudan a convertir ideas generales en opciones concretas y a decidir por dónde comenzar.',
  },
  {
    name: 'Angel',
    role: 'Tecnología de la Información',
    company: 'Kisco',
    href: 'https://www.linkedin.com/in/angel2909/',
    image: null,
    initials: 'A',
    quote:
      'Al revisar un tema de TI con Juan, valoro que escuche el contexto del equipo y evalúe las alternativas con criterio. La conversación ayuda a aclarar prioridades sin agregar complejidad innecesaria.',
  },
  {
    name: 'Julio Vásquez',
    role: 'Gerente General',
    company: 'All Plus',
    href: 'https://www.linkedin.com/in/julio-v%C3%A1squez-50435710b/',
    image: null,
    initials: 'JV',
    quote:
      'Juan entiende que una decisión tecnológica tiene que servir a la operación. Su forma de analizar el contexto y conversar sobre las opciones facilita avanzar con objetivos claros.',
  },
] as const;
---

<section id="testimonios" class="scroll-mt-28 py-14 sm:py-18" aria-labelledby="testimonials-heading">
  <div class="mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-sans text-[10px] font-semibold tracking-[0.22em] text-acid uppercase">Algunas colaboraciones</p>
      <h2 id="testimonials-heading" class="mt-3 max-w-2xl font-sans text-3xl font-semibold leading-tight tracking-[-0.035em] text-bone sm:text-4xl">
        Resolver mejor, trabajando en conjunto.
      </h2>
    </div>
    <p class="max-w-lg text-xs leading-5 text-smoke sm:text-sm">
      Experiencias compartidas con profesionales de dirección, gestión comercial y tecnología.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    {testimonials.map((testimonial) => (
      <article class="group flex h-full min-w-0 flex-col rounded-2xl bg-graphite/55 p-5 shadow-lg shadow-black/10 transition duration-300 hover:-translate-y-1 hover:bg-graphite hover:shadow-xl hover:shadow-black/20 motion-reduce:transform-none motion-reduce:transition-none sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <span class="font-sans text-[9px] font-semibold tracking-[0.14em] text-acid/80 uppercase">Colaboración</span>
          <span aria-hidden="true" class="font-serif text-3xl leading-none text-acid/60">“</span>
        </div>
        <blockquote class="mt-3 flex-1 text-sm leading-6 text-bone/90 sm:text-[15px] sm:leading-7">
          {testimonial.quote}
        </blockquote>
        <div class="mt-6 flex items-center gap-3">
          {testimonial.image ? (
            <Image src={testimonial.image} alt={`Retrato de ${testimonial.name}`} width={48} height={48} format="webp" quality={78} class="h-11 w-11 shrink-0 rounded-full object-cover ring-1 ring-white/10" />
          ) : (
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-steel font-sans text-xs font-semibold tracking-wide text-bone">{testimonial.initials}</span>
          )}
          <div class="min-w-0 flex-1">
            <p class="break-words font-sans text-sm font-semibold leading-5 text-bone">{testimonial.name}</p>
            <p class="mt-0.5 break-words text-xs leading-4 text-smoke">{testimonial.role} · {testimonial.company}</p>
          </div>
          <a href={testimonial.href} target="_blank" rel="noopener noreferrer" aria-label={`Ver perfil de ${testimonial.name} en LinkedIn (se abre en una pestaña nueva)`} class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-smoke transition-colors hover:bg-acid/10 hover:text-acid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acid">
            <Icon name="linkedin" size={16} class="h-4 w-4" />
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
