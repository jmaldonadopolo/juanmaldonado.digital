---
import Icon from '@/components/Icon.astro';

const steps = [
  {
    icon: 'lucide:target',
    title: 'Entender el contexto',
    description: 'Aclarar el reto, a quién afecta y qué resultado necesita el negocio.',
  },
  {
    icon: 'lucide:panels-top-left',
    title: 'Definir una mejora concreta',
    description: 'Priorizar una solución viable y acordar alcance antes de invertir tiempo y recursos.',
  },
  {
    icon: 'lucide:workflow',
    title: 'Avanzar con criterio',
    description: 'Elegir el siguiente paso de implementación y revisar si responde al objetivo inicial.',
  },
] as const;
---

<section id="proceso" class="scroll-mt-28 py-14 sm:py-18" aria-labelledby="approach-heading">
  <div class="mb-8 grid gap-5 sm:mb-10 lg:grid-cols-[1fr_0.8fr] lg:items-end">
    <div>
      <p class="font-sans text-[10px] font-semibold tracking-[0.22em] text-acid uppercase">Forma de trabajo</p>
      <h2 id="approach-heading" class="mt-3 max-w-xl font-sans text-3xl font-semibold leading-tight tracking-[-0.035em] text-bone sm:text-4xl">
        Primero el problema. Después, la tecnología.
      </h2>
    </div>
    <p class="max-w-xl text-sm font-light leading-6 text-smoke sm:text-base">
      Una conversación práctica para entender el reto, priorizar opciones y acordar un próximo paso.
    </p>
  </div>

    <ol class="grid gap-2 md:grid-cols-3">
      {
        steps.map((step) => (
          <li class="group rounded-2xl bg-graphite/55 p-5 shadow-lg shadow-black/10 transition duration-300 hover:-translate-y-1 hover:bg-graphite hover:shadow-xl hover:shadow-black/20 motion-reduce:transform-none motion-reduce:transition-none">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-acid/15 text-acid transition-colors group-hover:bg-acid group-hover:text-void motion-reduce:transition-none">
              <Icon name={step.icon} size={18} class="h-[18px] w-[18px]" />
            </span>
            <h3 class="mt-5 font-sans text-base font-semibold text-bone sm:text-lg">{step.title}</h3>
            <p class="mt-2 text-sm font-light leading-6 text-smoke">{step.description}</p>
          </li>
        ))
      }
    </ol>
</section>
